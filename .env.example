# Server Port (default 3000)
PORT=3000

# Partner Growth Copilot API Authentication Key (X-PGC-KEY header)
PGC_API_KEY=your-custom-pgc-api-key-here

# IBM watsonx.ai Service URL
# IBM Cloud US-South: https://us-south.ml.cloud.ibm.com
# IBM Cloud CA-TOR: https://ca-tor.ml.cloud.ibm.com
# IBM Cloud EU-DE: https://eu-de.ml.cloud.ibm.com
WATSONX_SERVICE_URL=https://ca-tor.ml.cloud.ibm.com

# IBM watsonx.ai Project ID (found in watsonx Studio project Manage tab)
WATSONX_PROJECT_ID=your-watsonx-project-id-here

# Foundation Model ID (e.g., meta-llama/llama-3-3-70b-instruct or ibm/granite-4-h-small)
WATSONX_MODEL_ID=meta-llama/llama-3-3-70b-instruct

# API Version Date String (YYYY-MM-DD format)
WATSONX_VERSION=2024-05-31

# IBM Cloud API Key (generated in IBM Cloud IAM -> API Keys)
WATSONX_API_KEY=your-ibm-cloud-api-key-here

# Watsonx Orchestrate Configuration
ORCHESTRATE_HOST_URL=https://api.ca-tor.watson-orchestrate.cloud.ibm.com/instances/dcf235a5-27f4-4e1c-bfb1-65b3e1cf5d66
ORCHESTRATE_AGENT_ID=255fce2b-bf14-4c1a-8b55-2633e1ecbbce
ORCHESTRATE_ENVIRONMENT_ID=d6d7e725-8c1b-401f-8bf0-8ebe14c4afcd
ORCHESTRATE_API_KEY=your-orchestrate-api-key-here
